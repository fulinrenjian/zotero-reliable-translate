{
  "name": "zotero-reliable-translate",
  "version": "0.1.4",
  "description": "Reliable Translate: an independently maintained, AGPL-licensed fork of Translate for Zotero with selection status, retry and saved translation notes.",
  "config": {
    "addonName": "划词翻译增强版（Reliable Translate）",
    "addonID": "reliabletranslate@codex.local",
    "addonRef": "reliabletranslate",
    "prefsPrefix": "extensions.zotero.ReliableTranslate",
    "addonInstance": "ReliableTranslate"
  },
  "main": "src/index.ts",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "release": "zotero-plugin release",
    "lint": "prettier --write . && eslint . --fix",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save",
    "test:local": "node --test test/reliableRunner.test.mjs test/reliableSelection.test.mjs test/reliableIntegration.test.cjs test/cnkiChunks.test.mjs test/reliablePopup.test.mjs test/reliablePopupGeometry.test.mjs test/reliableSetup.test.cjs test/reliablePanel.test.cjs test/fastProviders.test.cjs test/cnkiToken.test.cjs test/reliableNote.test.mjs test/reliableSpeedSetup.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fulinrenjian/zotero-reliable-translate.git"
  },
  "author": "fulinrenjian (fork maintainer); windingwind and contributors (upstream)",
  "contributors": [
    "windingwind and upstream contributors"
  ],
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/fulinrenjian/zotero-reliable-translate/issues"
  },
  "homepage": "https://github.com/fulinrenjian/zotero-reliable-translate#readme",
  "dependencies": {
    "franc": "^6.2.0",
    "iso639-js": "^1.1.3",
    "jsencrypt": "^3.5.0",
    "katex": "^0.16.25",
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.16.5",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.3"
  }
}
